#include <winver.h>

// GLFW looks this name up for the window class icon; Explorer uses the first icon for the exe.
GLFW_ICON ICON "../icons/kompressor.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Kompressor - archive extractor and super compressor"
      VALUE "FileVersion", "1.0.0"
      VALUE "ProductName", "Kompressor"
      VALUE "ProductVersion", "1.0.0"
      VALUE "OriginalFilename", "Kompressor.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

1 24 "kompressor.manifest"
