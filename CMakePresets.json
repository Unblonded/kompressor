{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release (system libraries: Homebrew / apt / dnf / pacman)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "debug",
      "inherits": "release",
      "displayName": "Debug (system libraries)",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "vcpkg-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets"
      }
    },
    {
      "name": "windows",
      "inherits": "vcpkg-base",
      "displayName": "Windows x64 (vcpkg, fully static single .exe)",
      "binaryDir": "${sourceDir}/build/windows",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-arm64",
      "inherits": "windows",
      "displayName": "Windows ARM64 (vcpkg, static)",
      "binaryDir": "${sourceDir}/build/windows-arm64",
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "arm64-windows-static" }
    },
    {
      "name": "macos-universal",
      "inherits": "vcpkg-base",
      "displayName": "macOS Universal 2 (arm64 + x86_64, vcpkg static)",
      "binaryDir": "${sourceDir}/build/macos-universal",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "universal-osx",
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "linux-static",
      "inherits": "vcpkg-base",
      "displayName": "Linux x64 (vcpkg static archive libs)",
      "binaryDir": "${sourceDir}/build/linux-static",
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "x64-linux" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "windows", "configurePreset": "windows" },
    { "name": "windows-arm64", "configurePreset": "windows-arm64" },
    { "name": "macos-universal", "configurePreset": "macos-universal" },
    { "name": "linux-static", "configurePreset": "linux-static" }
  ]
}
